[worldserver]

###################################################################################################
# MOD INSTANCE ITEM SCALING CONFIGURATION
###################################################################################################
#
#    ItemScaling.Enable
#        Description: Enable or disable the instance item scaling module entirely.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.Enable = 1

#
#    ItemScaling.ScaleDungeons
#        Description: Enable item scaling for normal 5-player instanced dungeons.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.ScaleDungeons = 1

#
#    ItemScaling.ScaleRaids
#        Description: Enable item scaling for instanced raids (10-man and 25-man).
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.ScaleRaids = 1

#
#    ItemScaling.ScaleHeroics
#        Description: Enable item scaling for heroic dungeons and heroic raids.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.ScaleHeroics = 1

#
#    Granular Instance Category Toggles (1-to-1 Parity with AutoBalance)
#        Description: Granular toggles to enable or disable item scaling per instance category:
#                     Scale.HeroicDungeons (5-player heroic dungeons)
#                     Scale.Raid10M        (10-player normal raids)
#                     Scale.Raid10MHeroic  (10-player heroic raids)
#                     Scale.Raid15M        (15-player raids, e.g. Upper Blackrock Spire)
#                     Scale.Raid20M        (20-player raids, e.g. Zul'Gurub, AQ20)
#                     Scale.Raid25M        (25-player normal raids)
#                     Scale.Raid25MHeroic  (25-player heroic raids)
#                     Scale.Raid40M        (40-player raids, e.g. Molten Core, BWL, AQ40)
#        Default:     1 - Enabled
#

ItemScaling.Scale.HeroicDungeons = 1
ItemScaling.Scale.Raid10M = 1
ItemScaling.Scale.Raid10MHeroic = 1
ItemScaling.Scale.Raid15M = 1
ItemScaling.Scale.Raid20M = 1
ItemScaling.Scale.Raid25M = 1
ItemScaling.Scale.Raid25MHeroic = 1
ItemScaling.Scale.Raid40M = 1

#
#    ItemScaling.ScaleChests
#        Description: Enable scaling for instanced chests and gameobject loot.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.ScaleChests = 1

#
#    ItemScaling.LevelScaling.Method
#        Description: Method used to calculate the target effective scaling level.
#                     "dynamic" - Scales relative to instance hierarchy (boss > elite > trash).
#                     "fixed"   - Scales directly to the highest real player level (H).
#        Default:     "dynamic"
#

ItemScaling.LevelScaling.Method = "dynamic"

#
#    ItemScaling.MinLevel
#        Description: Minimum level for item scaling to activate.
#                     If the highest real player level or instance tier is below this,
#                     items will drop with their default original stats.
#        Default:     1
#        Range:       1 - 80
#

ItemScaling.MinLevel = 1

#
#    ItemScaling.MaxLevel
#        Description: Maximum level for item scaling to activate.
#                     If the highest real player level or instance tier exceeds this,
#                     items will drop with their default original stats.
#                     For example, setting MaxLevel = 79 excludes level 80 players
#                     and level 80 instances/items so they remain default.
#        Default:     80
#        Range:       1 - 80
#

ItemScaling.MaxLevel = 80

#
#    ItemScaling.PreserveNativeLoot
#        Description: Skip synthetic variant generation and drop original Blizzard items when an item's
#                     native reference level matches the scaling target or player level
#                     (e.g., native 80 to 80, native 70 to 70, native 40 to 40, native 20 to 20).
#                     Replaces legacy ExcludedLevels with automatic, dynamic native-match detection.
#                     Works in both Live modes (Mode 1 Prewarm and Mode 2 Drop) and persisted-only mode.
#        Default:     1 - Enabled (drop original items and skip synthetic generation)
#                     0 - Disabled (generate synthetic variants even when levels match)
#

ItemScaling.PreserveNativeLoot = 1


#
#    ItemScaling.RealPlayersOnly
#        Description: Only eligible REAL players are counted when determining the highest level (H).
#                     Playerbots are strictly excluded from determining target level.
#        Default:     1 - Enabled (Bots never dictate scaling target)
#                     0 - Disabled (Bots also count towards H)
#

ItemScaling.RealPlayersOnly = 1

#
#    ItemScaling.IncludeGameMasters
#        Description: Whether GM characters (.gm on) in the instance affect the highest real player level.
#        Default:     0 - GMs do not affect scaling target
#                     1 - GMs affect scaling target
#

ItemScaling.IncludeGameMasters = 0

#
#    ItemScaling.ScaleUp
#        Description: Allow scaling low-level instance items upwards to a higher player level.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.ScaleUp = 1

#
#    ItemScaling.ScaleDown
#        Description: Allow scaling high-level instance items downwards to a lower player level.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.ScaleDown = 1

#
#    ItemScaling.ScaleExistingScalingItems
#        Description: Scale items that already have native Blizzard heirloom/scaling distributions
#                     (ScalingStatDistribution / ScalingStatValue).
#        Default:     0 - Disabled (Native heirlooms are excluded to prevent double-scaling)
#                     1 - Enabled
#

ItemScaling.ScaleExistingScalingItems = 0

#
#    Rarity / Quality Filters
#        Description: Controls which item qualities are eligible for scaling.
#                     ScalePoor      (Gray)
#                     ScaleCommon    (White)
#                     ScaleUncommon  (Green)
#                     ScaleRare      (Blue)
#                     ScaleEpic      (Purple)
#                     ScaleLegendary (Orange)
#                     ScaleArtifact  (Artifact)
#                     ScaleHeirloom  (Heirloom)
#        Default:     Poor=1, Common=1, Uncommon=1, Rare=1, Epic=1, Legendary=1, Artifact=1, Heirloom=0
#

ItemScaling.ScalePoor = 1
ItemScaling.ScaleCommon = 1
ItemScaling.ScaleUncommon = 1
ItemScaling.ScaleRare = 1
ItemScaling.ScaleEpic = 1
ItemScaling.ScaleLegendary = 1
ItemScaling.ScaleArtifact = 1
ItemScaling.ScaleHeirloom = 0

#
#    ItemScaling.RandomSuffix.Mode
#        Description: Determines how uncommon (green) items with Random Suffixes or Random Properties
#                     (e.g., "... of the Bear", "... of the Monkey") are handled by the scaling engine.
#
#                     In the standard WoW 3.3.5a client, bag tooltips for Random Suffixes on custom synthetic
#                     item IDs cannot calculate stat points without client-side Item.dbc edits, causing them
#                     to display "+0" stats.
#
#                     0 - Skip / Exclude (Default):
#                         Items with Random Suffix or Random Property are excluded from scaling and drop at their
#                         original base level/itemlevel. Bag tooltips display 100% correctly with no "+0" stats.
#
#                     1 - Stat Baking:
#                         Random suffix items scale to the dungeon's level bracket. The rolled stats and suffix name
#                         are baked directly into the synthetic item_template as fixed stats, setting RandomSuffix = 0.
#                         Displays scaled stats (+15 Stamina, etc.) in bag tooltips and chat links with NO client patches.
#
#        Default:     0
#

ItemScaling.RandomSuffix.Mode = 0

# Pure Live Generation Architecture. No core, Playerbots or client patches are required.
# All Live.* settings are startup-only.
#   ItemScaling.Live.Enable = 1 (Default): Pure Live Generation active.
#       Hybrid Mode 1: bounded world-update prewarm on instance entry + on-demand async generation on actual drop.
#       Mode 2: on-demand async generation on actual drop only.
#   ItemScaling.Live.Enable = 0: Persisted-variants-only mode.
#       Serves existing variants already present in scaled_item_variant. Unseen variants remain original Blizzard items.
#       No runtime generation, no background queueing, and no loot deferral wait.
# Both modes defer an unexpected miss and preserve original loot on failure/timeout.
# SQL staging stores complete snapshots before award; next startup promotes them to permanent tables.
ItemScaling.Live.Enable = 1
ItemScaling.Live.GenerationMode = 1

# Available inert item-template slots loaded at startup. Used slots are immutable.
# Increasing capacity takes effect at the next restart. No runtime store resizing occurs.
ItemScaling.Live.ReservedSlots = 4096
ItemScaling.Live.MaxPendingVariants = 4096
ItemScaling.Live.MaxPublishPerTick = 64
ItemScaling.Live.LootWaitTimeoutMs = 10000

#
#    ItemScaling.Announce
#        Description: Whether to send system chat messages when entering a dungeon/raid indicating the
#                     scaling target level, and broadcasting when a higher-level player joins and triggers
#                     a loot scaling recalculation.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ItemScaling.Announce = 1

#
#    ItemScaling.PreserveNonZeroStats
#        Description: Prevents non-zero stats from vanishing purely due to rounding to 0 at low levels.
#                     If an item originally has +5 Haste, scaled version will have at least +1 Haste.
#        Default:     1 - Enabled
#                     0 - Disabled (allow rounding to 0)
#

ItemScaling.PreserveNonZeroStats = 1

#
#    ItemScaling.RequiredLevel.Policy
#        Description: Determines how RequiredLevel is assigned to scaled variants:
#                     "target-capped-player" - min(L_target, H) clamped to 1..80
#                     "player"               - exactly H
#                     "target"               - exactly L_target
#        Default:     "target"
#

ItemScaling.RequiredLevel.Policy = "target"

#
#    Dynamic Scaling Floor and Ceiling
#        Description: In dynamic mode, controls how items scale relative to the creature's in-instance level (L_mob).
#                     Floor:   levels subtracted from L_mob (e.g. 3 means raid boss at 80+3=83 drops level 80 loot,
#                              trash at 80 drops level 77 loot; 5 means raid boss drops level 78 loot; 0 means capped at player level)
#                     Ceiling: upper clamp relative to player level (PlayerLevel + Ceiling)
#                     Default: Floor = 3, Ceiling = 0
#

ItemScaling.Dynamic.Ceiling.Dungeons = 0
ItemScaling.Dynamic.Floor.Dungeons = 3
ItemScaling.Dynamic.Ceiling.Raids = 0
ItemScaling.Dynamic.Floor.Raids = 3

#
#    Dynamic Scaling for Heroic Dungeons (TBC & Wrath)
#        Description: Fine-grained ceiling and floor configuration for 5-player Heroic dungeons.
#                     Vanilla (Classic) dungeons do not have heroic difficulties, so heroic options are
#                     disabled/bypassed for Vanilla and will use normal dungeon floor/ceiling.
#                     TBC: The Burning Crusade heroic dungeons (expansion 1)
#                     Wrath: Wrath of the Lich King heroic dungeons (expansion 2)
#                     HeroicDungeons serves as the general fallback for custom/other heroic dungeons.
#        Default:     Ceiling = 0, Floor = 3
#

ItemScaling.Dynamic.Ceiling.HeroicDungeons = 0
ItemScaling.Dynamic.Floor.HeroicDungeons = 3
ItemScaling.Dynamic.Ceiling.HeroicDungeons.TBC = 0
ItemScaling.Dynamic.Floor.HeroicDungeons.TBC = 3
ItemScaling.Dynamic.Ceiling.HeroicDungeons.Wrath = 0
ItemScaling.Dynamic.Floor.HeroicDungeons.Wrath = 3

#
#    Dynamic Scaling for Raid Categories (1-to-1 Parity with AutoBalance)
#        Description: Fine-grained dynamic ceiling and floor configurations for distinct raid sizes
#                     and difficulties:
#                     Raid10M / Raid10MHeroic: 10-player raids
#                     Raid15M: 15-player raids (e.g. Upper Blackrock Spire)
#                     Raid20M: 20-player raids (e.g. Zul'Gurub, Ruins of Ahn'Qiraj)
#                     Raid25M / Raid25MHeroic: 25-player raids
#                     Raid40M: 40-player raids (e.g. Molten Core, Blackwing Lair, AQ40)
#                     HeroicRaids serves as the generic fallback for heroic raids.
#        Default:     Ceiling = 0, Floor = 3
#

ItemScaling.Dynamic.Ceiling.HeroicRaids = 0
ItemScaling.Dynamic.Floor.HeroicRaids = 3

ItemScaling.Dynamic.Ceiling.Raid10M = 0
ItemScaling.Dynamic.Floor.Raid10M = 3
ItemScaling.Dynamic.Ceiling.Raid10MHeroic = 0
ItemScaling.Dynamic.Floor.Raid10MHeroic = 3

ItemScaling.Dynamic.Ceiling.Raid15M = 0
ItemScaling.Dynamic.Floor.Raid15M = 3

ItemScaling.Dynamic.Ceiling.Raid20M = 0
ItemScaling.Dynamic.Floor.Raid20M = 3

ItemScaling.Dynamic.Ceiling.Raid25M = 0
ItemScaling.Dynamic.Floor.Raid25M = 3
ItemScaling.Dynamic.Ceiling.Raid25MHeroic = 0
ItemScaling.Dynamic.Floor.Raid25MHeroic = 3

ItemScaling.Dynamic.Ceiling.Raid40M = 0
ItemScaling.Dynamic.Floor.Raid40M = 3

#
#    Per-Instance Dynamic Level Overrides
#        Description: Override ceiling and floor values for specific map IDs.
#                     Format: "[MapID] [Ceiling] [Floor], [MapID] [Ceiling] [Floor], ..."
#                     Also accepts AutoBalance 5-token syntax:
#                     "[MapID] [SkipHigher] [SkipLower] [Ceiling] [Floor], ..."
#                     Example: "229 3 0, 230 5 3"
#        Default:     "" (empty string = no overrides)
#

ItemScaling.Dynamic.PerInstance = ""

#
#    Dynamic Floor & Ceiling Variance (Randomized Level Shifts)
#        Description: Allows loot generation to roll configurable percentage chances for shifts of
#                     -3, -2, -1, +1, +2, +3 levels on Dynamic Floor and Ceiling.
#
#                     FLOOR VARIANCE:
#                     Because target level is (L_mob - Floor), negative floor deltas REDUCE the floor,
#                     which increases the drop level (favorable / lucky drops for players!):
#                       -1 shift: Floor becomes 2 -> Level 82 dungeon boss drops level 80 loot!
#                       -2 shift: Floor becomes 1 -> Level 80 dungeon trash drops level 79 loot!
#                       -3 shift: Floor becomes 0 -> Jackpot! Level 80 trash drops level 80 loot!
#                       Remaining %: Uses standard base Floor (3), dropping level 79 loot from boss.
#
#                     CEILING VARIANCE:
#                     Because ceiling caps max loot level (PlayerLevel + Ceiling), positive ceiling deltas
#                     expand the upper cap above player level. (Disabled by default, base ceiling remains 0).
#
#                     FORMAT SYNTAX:
#                     Accepts named pair syntax (omitted values default to 0%):
#                       "-1:20.0, -2:10.0, -3:5.0"
#                     Or 6-element positional comma-separated floats (-3, -2, -1, +1, +2, +3):
#                       "5.0, 10.0, 20.0, 0.0, 0.0, 0.0"
#                     Percentages do NOT need to sum to 100. Any remaining percentage out of 100%
#                     automatically uses the unmodified base floor/ceiling.
#
#        Defaults:    Floor.Variance.Enable = 1 (Enabled)
#                     Ceiling.Variance.Enable = 0 (Disabled)
#                     Variance.Scope = 0 (0 = Per-Loot / Per-Boss, 1 = Per-Item)
#

ItemScaling.Dynamic.Floor.Variance.Enable = 1
ItemScaling.Dynamic.Ceiling.Variance.Enable = 0
ItemScaling.Dynamic.Variance.Scope = 0

ItemScaling.Dynamic.Floor.Variance.Dungeons = "-1:20.0, -2:10.0, -3:5.0"
ItemScaling.Dynamic.Floor.Variance.HeroicDungeons = "-1:20.0, -2:10.0, -3:5.0"
ItemScaling.Dynamic.Floor.Variance.HeroicDungeons.TBC = ""
ItemScaling.Dynamic.Floor.Variance.HeroicDungeons.Wrath = ""
ItemScaling.Dynamic.Floor.Variance.Raids = "-1:20.0, -2:10.0, -3:5.0"
ItemScaling.Dynamic.Floor.Variance.HeroicRaids = ""
ItemScaling.Dynamic.Floor.Variance.Raid10M = ""
ItemScaling.Dynamic.Floor.Variance.Raid10MHeroic = ""
ItemScaling.Dynamic.Floor.Variance.Raid15M = ""
ItemScaling.Dynamic.Floor.Variance.Raid20M = ""
ItemScaling.Dynamic.Floor.Variance.Raid25M = ""
ItemScaling.Dynamic.Floor.Variance.Raid25MHeroic = ""
ItemScaling.Dynamic.Floor.Variance.Raid40M = ""

ItemScaling.Dynamic.Ceiling.Variance.Dungeons = ""
ItemScaling.Dynamic.Ceiling.Variance.HeroicDungeons = ""
ItemScaling.Dynamic.Ceiling.Variance.HeroicDungeons.TBC = ""
ItemScaling.Dynamic.Ceiling.Variance.HeroicDungeons.Wrath = ""
ItemScaling.Dynamic.Ceiling.Variance.Raids = ""
ItemScaling.Dynamic.Ceiling.Variance.HeroicRaids = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid10M = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid10MHeroic = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid15M = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid20M = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid25M = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid25MHeroic = ""
ItemScaling.Dynamic.Ceiling.Variance.Raid40M = ""

#
#    ItemScaling.UseAutoBalanceSettings
#        Description: If mod-autobalance is loaded, automatically adopt its configured LevelScaling.Method,
#                     Dynamic.Floor, and Dynamic.Ceiling settings for instance types directly from AutoBalance.conf.
#                     Also ingests AutoBalance.LevelScaling.DynamicLevel.PerInstance overrides.
#        Default:     0 - Disabled (strictly use ItemScaling.* config values exclusively)
#                     1 - Enabled (adopt AutoBalance values)
#

ItemScaling.UseAutoBalanceSettings = 0

#
#    ItemScaling.SyntheticEntry.Start
#        Description: Starting item entry for dynamically allocated synthetic item templates.
#                     Can be set to "auto" to automatically pick the lowest safe compact range
#                     immediately above the maximum existing item ID in the database (e.g. ~60,000),
#                     avoiding unnecessarily sparse template IDs.
#                     Or specify a custom fixed starting ID.
#        Default:     "auto"
#

ItemScaling.SyntheticEntry.Start = "auto"

#
#    ItemScaling.SyntheticEntry.AutoOffset
#        Description: Buffer space to leave between the highest database item entry and the
#                     start of synthetic scaled items when SyntheticEntry.Start is set to "auto".
#        Default:     1000
#

ItemScaling.SyntheticEntry.AutoOffset = 1000


#
#    ItemScaling.BracketStep
#        Description: Level interval between runtime scaling tiers (e.g. 2 means tiers at
#                     every 2 levels). Runtime targets round down to this bracket; MaxLevel
#                     is always included. Native level matches retain their original item.
#                     Default 1 keeps item and RequiredLevel targets exactly aligned with the
#                     mob/boss target level. Larger steps reduce database size.
#        Default:     1
#        Range:       1 - 10
#

ItemScaling.BracketStep = 1

#
#    ItemScaling.FormulaVersion
#        Description: Version tag for the scaling curve calculation. Preserved in database records.
#                     Increment when changing PreserveNonZeroStats or formula input data.
#                     Previously generated variants keep their stored family metadata; incompatible families are not selected for new scaling.
#        Default:     1
#

ItemScaling.FormulaVersion = 1

#
#    ItemScaling.ExcludedMapIds
#        Description: Comma-separated list of Map IDs excluded from item scaling.
#        Default:     ""
#

ItemScaling.ExcludedMapIds = ""

#
#    ItemScaling.ExcludedItemIds
#        Description: Comma-separated list of base Item IDs excluded from item scaling.
#        Default:     ""
#

ItemScaling.ExcludedItemIds = ""

#
#    ItemScaling.Debug
#        Description: Enable verbose debug logging for item scaling calculations.
#        Default:     0 - Disabled
#                     1 - Enabled
#

ItemScaling.Debug = 0

# Highest ID the module may allocate (60000..10000000).
# Recovery preserves issued IDs even above a newly lowered allocation limit.
# The core's fast lookup vector grows with the highest item ID. Existing IDs are never renumbered.
ItemScaling.SyntheticEntry.Maximum = 2000000

# All ItemScaling settings require a restart; .reload config does not mutate the active snapshot.
